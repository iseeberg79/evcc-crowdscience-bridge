# Your evcc Crowdscience device ID (from https://evcc-crowdscience.de/) – required
# Do not use quotes around the value
DEVICE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Local MQTT broker (defaults work when running alongside Mosquitto in Docker Compose)
# LOCAL_HOST=mosquitto    # Docker Compose: use service name, NOT 127.0.0.1 or localhost
# LOCAL_PORT=1883
# LOCAL_USER=mqtt
# LOCAL_PASSWORD=

# Local topic prefix to subscribe (default: evcc)
# LOCAL_TOPIC=evcc

# Remote broker (defaults, usually no need to change)
# REMOTE_HOST=mqtt.evcc-crowdscience.de
# REMOTE_PORT=443

# Stats log interval in seconds (default: 300, set to 0 to disable)
# STATS_INTERVAL=300

# Set to false to disable topic filtering (useful for debugging)
# FILTER_ENABLED=true
